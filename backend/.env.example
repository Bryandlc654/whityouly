# ------------------------------------------------------------------
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env con secretos al repositorio.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Número de proxies de confianza por delante de la app (para IP real en rate limit).
TRUST_PROXY=1

# Base de datos (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/whityouly?schema=public

# --- Autenticación ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-por-un-secreto-largo-y-aleatorio
# Opcional: secreto independiente para refresh tokens (recomendado).
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h
JWT_PASSWORD_RESET_EXPIRES_IN=15m

# --- Rate limiting ---
# Si se define, el rate limiting se comparte entre instancias vía Redis.
# Si está vacío, se usa un almacén en memoria (solo para una instancia).
REDIS_URL=

# --- Contraseñas ---
# Comprueba las contraseñas contra Have I Been Pwned. Pon "false" para desactivarlo.
PASSWORD_BREACH_CHECK_ENABLED=true

# --- Bloqueo de inicio de sesión ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000

# --- Cooldown de correos sensibles (ms) ---
PASSWORD_RESET_COOLDOWN_MS=60000
EMAIL_RESEND_COOLDOWN_MS=60000

# --- Sesiones ---
# Máximo de sesiones activas por usuario (se revocan las más antiguas).
MAX_SESSIONS_PER_USER=10
# Frecuencia de purga de sesiones expiradas (ms). 0 desactiva la limpieza.
SESSION_CLEANUP_INTERVAL_MS=3600000

# --- Cookie de refresh token (httpOnly) ---
# En producción usa COOKIE_SECURE=true. Si frontend y backend están en dominios
# distintos, usa COOKIE_SAMESITE=none (requiere Secure=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- URLs / CORS ---
# URL pública del frontend (se usa para construir los enlaces de verificación y reset).
FRONTEND_URL=http://localhost:3001
# Orígenes permitidos separados por coma.
CORS_ORIGINS=http://localhost:3001

# --- Correo saliente (SMTP) ---
# Si MAIL_HOST está vacío, los correos se registran en consola (jsonTransport),
# útil para desarrollo sin proveedor real.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="No Reply Whityouly" <noreply@whityouly.com>

# --- Almacenamiento de medios (avatares) ---
# Driver: "local" (la API sirve /media, solo para desarrollo) o "s3".
STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./uploads/media
# Base pública de los archivos. En producción debe ser el dominio/CDN que
# sirve el bucket (p. ej. https://cdn.whityouly.com).
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media

# Solo obligatorias si STORAGE_DRIVER=s3 (Cloudflare R2, MinIO, Backblaze...).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para MinIO/R2, false para AWS.
S3_FORCE_PATH_STYLE=true

# --- Avatar del personaje ---
# Tope del archivo subido en bytes (2 MB por defecto).
AVATAR_MAX_BYTES=2097152
# Tope de píxeles totales: corta las imágenes "bomba" antes de decodificarlas.
AVATAR_MAX_PIXELS=40000000
# Lado (px) y calidad del WebP generado tras re-codificar la imagen.
AVATAR_OUTPUT_SIZE=512
AVATAR_QUALITY=82
# Subidas de avatar permitidas por usuario y hora.
AVATAR_UPLOADS_PER_HOUR=5
# Frecuencia de purga de avatares huérfanos (ms) y antigüedad mínima (ms).
MEDIA_CLEANUP_INTERVAL_MS=3600000
MEDIA_ORPHAN_TTL_MS=86400000
