// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. Identidad, Autenticación y Seguridad
// ----------------------------------------------------------------------------

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum Status {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  isEmailVerified  Boolean           @default(false)
  passwordHash     String?
  internalUsername String?           @unique
  role             Role              @default(USER)
  status           Status            @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  oauthIdentities  OAuthIdentity[]
  sessions         Session[]
  preferences      UserPreference?
  character        Character?
  bookmarks        Bookmark[]
  emotionalLogs    EmotionalLog[]
  creations        Creation[]
  reports          Report[]
  notifications    Notification[]
  mediaAssets      MediaAsset[]

  @@map("users")
}

model OAuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_identities")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // La purga de sesiones caducadas borra por `expiresAt` de forma periódica.
  // Es la tabla que más crece (una fila por inicio de sesión) y sin este índice
  // cada pasada recorre todas las filas.
  @@index([expiresAt])
  @@map("sessions")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  theme              String   @default("light")
  language           String   @default("es")
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Los seudónimos son únicos sin distinguir mayúsculas. Prisma no permite
// declarar índices funcionales, por eso la unicidad real la garantiza la base
// con `CREATE UNIQUE INDEX characters_name_lower_key ON characters (lower(name))`
// (aplicada en Neon). Sin ella, dos registros concurrentes "Ana"/"ana" pasarían
// el chequeo de la aplicación. El mismo índice acelera las consultas por
// seudónimo, que son case-insensitive.
model Character {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String   @unique
  tagline         String?
  avatarUrl       String?
  bio             String?
  privacySettings Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories         Story[]
  comments        Comment[]
  interests       CharacterInterest[]
  companionshipsGiven  Companionship[] @relation("CharacterGivesCompanionship")
  companionshipsReceived Companionship[] @relation("CharacterReceivesCompanionship")
  followers       Follower[] @relation("CharacterFollowers")
  following       Follower[] @relation("CharacterFollowing")
  // Notificaciones que este personaje provocó (seguidor, comentarista,
  // acompañante...). Se separa del destinatario: `Notification.userId` es quien
  // recibe y `actorCharacterId` es quien lo originó.
  notificationsTriggered Notification[] @relation("NotificationActor")

  // El barrido de avatares huérfanos busca por `avatarUrl`. Sin índice, esa
  // comprobación recorre la tabla de personajes entera en cada pasada.
  @@index([avatarUrl])
  @@map("characters")
}

// Catálogo cerrado de intereses. No es texto libre: las etiquetas se curan para
// que nadie pueda inventar nombres sin moderar, y para poder buscar y agrupar
// por interés con índice.
model Interest {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  characters CharacterInterest[]

  @@map("interests")
}

model CharacterInterest {
  characterId String
  interestId  String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  interest  Interest  @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([characterId, interestId])
  @@index([interestId])
  @@map("character_interests")
}

// ----------------------------------------------------------------------------
// 2. Archivos y Multimedia
// ----------------------------------------------------------------------------

enum EntityType {
  AVATAR
  STORY_MEDIA
  CREATION_MEDIA
  NONE
}

model MediaAsset {
  id     String  @id @default(uuid())
  userId String
  fileUrl String
  // Clave del objeto en el bucket. Es opcional para no tener que reescribir las
  // filas existentes de golpe; cuando falta se deduce de `fileUrl`.
  key          String?
  originalName String?
  mimeType     String?
  sizeBytes    BigInt?
  width        Int?
  height       Int?
  entityType   EntityType @default(NONE)
  entityId     String?
  createdAt    DateTime   @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Dos adjuntos posibles por etapa (imagen y audio), por eso las relaciones van
  // nombradas: con dos claves foráneas a la misma tabla Prisma exige el nombre.
  storyUpdates   StoryUpdate[] @relation("StoryUpdateMedia")
  storyUpdatesAudio StoryUpdate[] @relation("StoryUpdateAudio")
  creations      Creation[]
  musicTracks    MusicTrack[]

  // Listados por propietario: sin este índice, la biblioteca de cada usuario
  // obliga a recorrer todos los archivos al paginar.
  @@index([userId, createdAt])
  // El barrido de huérfanos filtra por tipo y antigüedad. El índice de arriba
  // empieza por `userId`, así que no le sirve para esa consulta.
  @@index([entityType, createdAt])
  @@map("media_assets")
}

// ----------------------------------------------------------------------------
// 3. Historias y Evolución
// ----------------------------------------------------------------------------

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REPORTED
  MODERATED
  DELETED
}

model Story {
  id          String      @id @default(uuid())
  characterId String
  title       String
  visibility  Visibility  @default(PUBLIC)
  status      StoryStatus @default(DRAFT)
  // Cuando la persona destaca un relato en su perfil público.
  featuredAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  updates        StoryUpdate[]
  categories     StoryCategory[]
  tags           StoryTag[]
  emotions       StoryEmotion[]
  comments       Comment[]
  companionships Companionship[] @relation("StoryReceivesCompanionship")
  followers      Follower[]      @relation("StoryFollowers")
  music          StoryMusic[]
  // Destacado editorial (lo elige administración). Es independiente de
  // `featuredAt`, que es el relato que la propia persona fija en su perfil.
  featuredStory  FeaturedStory?

  @@index([createdAt])
  // Listado del propietario ("mis relatos"): filtra por personaje y ordena por
  // fecha. Sin el índice, cada carga recorre toda la tabla de relatos.
  @@index([characterId, createdAt])
  // Feed público: filtra por estado y visibilidad antes de ordenar por fecha.
  @@index([status, visibility, createdAt])
  // "Historias destacadas" del perfil público: se leen por personaje y fecha.
  @@index([characterId, featuredAt])
  // El contenido destacado cae a los relatos que sus autores marcaron en el
  // perfil cuando no hay curación; esa consulta ordena por `featuredAt` sola.
  @@index([featuredAt])
  @@map("stories")
}

model StoryUpdate {
  id           String   @id @default(uuid())
  storyId      String
  content      String
  // Imagen que ilustra la etapa.
  mediaAssetId String?
  // Audio que acompaña la etapa (voz, ambiente...). Es independiente de la
  // imagen: una etapa puede llevar texto, imagen y audio a la vez.
  audioAssetId String?
  stageOrder   Int      @default(1)
  createdAt    DateTime @default(now())

  story      Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("StoryUpdateMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  audioAsset MediaAsset? @relation("StoryUpdateAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)

  // Postgres no indexa las claves foráneas por su cuenta, y al borrar un
  // archivo se cuenta cuántas veces lo referencia cada tabla.
  @@index([mediaAssetId])
  @@index([audioAssetId])
  // La lectura del detalle carga las etapas de un relato ordenadas por número.
  // Postgres no indexa la FK, así que sin esto cada lectura recorre la tabla.
  @@index([storyId, stageOrder])
  @@map("story_updates")
}

// ----------------------------------------------------------------------------
// 4. Taxonomía
// ----------------------------------------------------------------------------

model Category {
  id   String @id @default(uuid())
  name String @unique

  stories StoryCategory[]

  @@map("categories")
}

model Emotion {
  id       String @id @default(uuid())
  name     String @unique
  colorHex String?

  stories StoryEmotion[]
  logs    EmotionalLog[]

  @@map("emotions")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  stories StoryTag[]

  @@map("tags")
}

model StoryCategory {
  storyId    String
  categoryId String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([storyId, categoryId])
  @@map("story_categories")
}

model StoryEmotion {
  storyId   String
  emotionId String
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  emotion   Emotion @relation(fields: [emotionId], references: [id], onDelete: Cascade)

  @@id([storyId, emotionId])
  @@map("story_emotions")
}

model StoryTag {
  storyId String
  tagId   String
  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@map("story_tags")
}

// ----------------------------------------------------------------------------
// 5. Interacción, Comunidad y Notificaciones
// ----------------------------------------------------------------------------

model Companionship {
  id                String   @id @default(uuid())
  characterId       String
  targetCharacterId String?
  targetStoryId     String?
  createdAt         DateTime @default(now())

  character       Character  @relation("CharacterGivesCompanionship", fields: [characterId], references: [id], onDelete: Cascade)
  targetCharacter Character? @relation("CharacterReceivesCompanionship", fields: [targetCharacterId], references: [id], onDelete: Cascade)
  targetStory     Story?     @relation("StoryReceivesCompanionship", fields: [targetStoryId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  // Contar acompañamientos y comprobar duplicados: se consulta por objetivo y
  // por quién acompaña. Postgres no indexa las FK por su cuenta.
  @@index([targetStoryId])
  @@index([targetCharacterId])
  @@map("companionships")
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  MODERATED
  DELETED
}

model Comment {
  id          String        @id @default(uuid())
  storyId     String
  characterId String
  parentId    String?
  content     String
  status      CommentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  // El listado de comentarios de un relato filtra por relato y ordena por fecha.
  // Las tendencias agrupan comentarios de la última ventana por estado y fecha.
  // Sin estos índices, ambas consultas recorren la tabla entera (es la tabla que
  // más crece: un comentario por cada interacción escrita).
  @@index([storyId, createdAt])
  @@index([status, createdAt])
  @@map("comments")
}

model Follower {
  id                   String   @id @default(uuid())
  followerId           String
  followingCharacterId String?
  followingStoryId     String?
  createdAt            DateTime @default(now())

  follower           Character  @relation("CharacterFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingCharacter Character? @relation("CharacterFollowers", fields: [followingCharacterId], references: [id], onDelete: Cascade)
  followingStory     Story?     @relation("StoryFollowers", fields: [followingStoryId], references: [id], onDelete: Cascade)

  // El feed de seguidos resuelve "a quién sigo" por `followerId`; el índice
  // compuesto cubre esa consulta. El segundo acelera el recuento de seguidores
  // y el filtro "quién me sigue".
  @@index([followerId, followingCharacterId])
  @@index([followingCharacterId])
  // "Historias que sigo": se consulta por historia seguida (contador) y por
  // seguidor para listar las tuyas.
  @@index([followingStoryId])
  @@map("followers")
}

enum NotificationStatus {
  UNREAD
  READ
}

model Notification {
  id         String             @id @default(uuid())
  // Destinatario de la notificación.
  userId     String
  // Código del evento: FOLLOW, COMMENT, COMMENT_REPLY, COMPANIONSHIP,
  // STORY_UPDATE, MODERATION o SYSTEM.
  type       String
  // Quién lo provocó (nulo en avisos de sistema o si el personaje se borró).
  actorCharacterId String?
  // Objeto sobre el que actuar: STORY, CHARACTER o SYSTEM.
  entityType String
  entityId   String?
  status     NotificationStatus @default(UNREAD)
  createdAt  DateTime           @default(now())

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorCharacter Character? @relation("NotificationActor", fields: [actorCharacterId], references: [id], onDelete: SetNull)

  // La bandeja se lee por destinatario y fecha, y el contador de no leídas
  // filtra además por estado. Los dos índices cubren ambos casos.
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([actorCharacterId])
  @@map("notifications")
}

// Contenido destacado por administración: una lista curada y ordenada de
// relatos. `expiresAt` permite programar su salida de portada sin volver a
// tocarla. Es distinto del destacado del perfil, que controla su autor.
model FeaturedStory {
  id        String    @id @default(uuid())
  storyId   String    @unique
  // Menor = aparece antes. Los empates se resuelven por fecha de curación.
  position  Int       @default(0)
  note      String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([position, createdAt])
  @@map("featured_stories")
}

// ----------------------------------------------------------------------------
// 6. Módulos Privados e IA
// ----------------------------------------------------------------------------

enum TargetType {
  STORY
  CREATION
  MEDIA
}

model Bookmark {
  id         String     @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // La biblioteca de guardados es por usuario: se listan con un solo índice.
  @@index([userId])
  @@map("bookmarks")
}

model EmotionalLog {
  id          String   @id @default(uuid())
  userId      String
  emotionId   String
  intensity   Int      // 1 to 10
  contextNote String?
  loggedAt    DateTime
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotion Emotion @relation(fields: [emotionId], references: [id], onDelete: Cascade)

  @@map("emotional_logs")
}

enum CreationVisibility {
  PRIVATE
  PUBLIC
  STORY_SHARED
}

model Creation {
  id           String             @id @default(uuid())
  userId       String
  type         String
  title        String
  content      String
  mediaAssetId String?
  visibility   CreationVisibility @default(PRIVATE)
  aiMetadata   Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([mediaAssetId])
  @@map("creations")
}

// ----------------------------------------------------------------------------
// 7. Moderación y Analíticas
// ----------------------------------------------------------------------------

enum ReportedType {
  USER
  CHARACTER
  STORY
  COMMENT
  CREATION
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

model Report {
  id             String       @id @default(uuid())
  reporterUserId String
  reportedType   ReportedType
  reportedId     String
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  eventType   String
  userId      String?
  characterId String?
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("analytics_events")
}

// ----------------------------------------------------------------------------
// 8. Música (Fase 4)
// ----------------------------------------------------------------------------

model MusicTrack {
  id               String   @id @default(uuid())
  title            String
  artist           String?
  mediaAssetId     String
  durationSeconds  Int?
  licensingModel   String?
  createdAt        DateTime @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  storyMusic StoryMusic[]
  playlistTracks PlaylistTrack[]

  @@index([mediaAssetId])
  @@map("music_tracks")
}

model StoryMusic {
  storyId      String
  musicTrackId String
  volumeLevel  Int    @default(50)

  story      Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  musicTrack MusicTrack @relation(fields: [musicTrackId], references: [id], onDelete: Cascade)

  @@id([storyId, musicTrackId])
  @@map("story_music")
}

enum PlaylistVisibility {
  PRIVATE
  PUBLIC
}

model Playlist {
  id          String             @id @default(uuid())
  characterId String
  name        String
  visibility  PlaylistVisibility @default(PRIVATE)
  createdAt   DateTime           @default(now())

  tracks PlaylistTrack[]

  @@map("playlists")
}

model PlaylistTrack {
  playlistId   String
  musicTrackId String
  order        Int

  playlist   Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  musicTrack MusicTrack @relation(fields: [musicTrackId], references: [id], onDelete: Cascade)

  @@id([playlistId, musicTrackId])
  @@map("playlist_tracks")
}
